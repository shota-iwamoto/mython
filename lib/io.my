# io.my — ファイル入出力（第14章）
#
# ★ extern（C との境界）をこのファイルに閉じ込めます。
#   利用者は io.read_file を使い、my_read_file を知りません。
#   ランタイム側の名前が変わっても、直すのはここだけです。

extern def my_read_file(path: str) -> str
extern def my_write_file(path: str, text: str) -> None
extern def my_file_exists(path: str) -> int

# ファイル全体を読む（開けなければ実行時エラーで終了する）
def read_file(path: str) -> str:
    return my_read_file(path)

def write_file(path: str, text: str) -> None:
    my_write_file(path, text)

# ⚠️ bool は extern の境界を越えられないので、int で受けてここで bool にします
#    （docs/chapters/ch14-stdlib.md 14.2 節）。
def exists(path: str) -> bool:
    return my_file_exists(path) == 1
