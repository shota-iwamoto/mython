# wordcount.my — 標準ライブラリだけで書く語数カウント（第14章）
#
#   $ ./build/mythonc examples/wordcount.my -o wc && ./wc examples/sample.txt
#
# ★ ここに出てくる split / strip / Dict は、すべて lib/*.my に
#   Mython で書かれています。コンパイラは何も特別扱いしていません。
import io
import strings
import sys
import dict

def main() -> int:
    args: list[str] = sys.argv()
    if len(args) < 2:
        print("使い方: wordcount <ファイル>")
        return 1

    text: str = io.read_file(args[1])
    counts: dict.Dict = dict.Dict()

    for line in strings.split(text, "\n"):
        for word in strings.split(strings.strip(line), " "):
            if len(word) > 0:
                counts.set(word, counts.get_or(word, 0) + 1)

    for k in counts.keys():
        print(k + ": " + str(counts.get(k)))
    return 0
