# OUTPUT: 3
# ファイル入出力（C ランタイムを io.my が薄く包んでいる）
import io
import strings

def main() -> int:
    path: str = "/tmp/mython_lib_io_test.txt"
    io.write_file(path, "a,b,c")
    print(io.read_file(path) == "a,b,c")
    print(io.exists(path))
    print(io.exists("/tmp/mython_no_such_file_12345.txt"))
    print(len(strings.split(io.read_file(path), ",")))
    return 0
