# OUTPUT: 2
# OUTPUT: -3
# OUTPUT: 4
# OUTPUT: -5
# OUTPUT: -3
# OUTPUT: 7
# OUTPUT: 8
# OUTPUT: -3
# OUTPUT: -5
# OUTPUT: 11
# OUTPUT: -3
# OUTPUT: 13
# OUTPUT: 14
# OUTPUT: -15
# FizzBuzz の制御構造。文字列は第9章なので、言葉のかわりに負の数を出す。
def main() -> int:
    i: int = 1
    while i <= 15:
        if i % 15 == 0:
            print(-15)
        elif i % 3 == 0:
            print(-3)
        elif i % 5 == 0:
            print(-5)
        else:
            print(i)
        i += 1
    return 0
